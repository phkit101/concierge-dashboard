/* ========== Base Reset ========== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  background: #1a1a1a;
  color: #e6e6e6;
}

/* ========== Layout Shell ========== */
.shell {
  display: flex;
  height: 100vh;
}

/* ========== Sidebar ========== */
.sidebar {
  width: 280px;
  background: #111;
  border-right: 2px solid #222;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  margin-bottom: 30px;
}

.brand-icon {
  background: #333;
  color: #fff;
  font-weight: bold;
  padding: 12px 16px;
  border-radius: 6px;
  margin-right: 12px;
}

.brand-title {
  font-size: 20px;
  font-weight: bold;
}

.brand-sub {
  font-size: 12px;
  color: #999;
}

.nav-section-title {
  font-size: 14px;
  margin-bottom: 10px;
  color: #aaa;
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nav-item {
  background: #222;
  padding: 12px;
  border-radius: 6px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-item.primary {
  background: #333;
}

.nav-item-label {
  display: flex;
  align-items: center;
  gap: 8px;
}

.nav-dot {
  width: 10px;
  height: 10px;
  background: #888;
  border-radius: 50%;
}

.nav-pill {
  background: #444;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 12px;
}

.sidebar-footer {
  margin-top: 20px;
}

.status-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
}

.status-pill {
  background: #333;
  padding: 4px 10px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.status-dot {
  width: 8px;
  height: 8px;
  background: #4caf50;
  border-radius: 50%;
}

.hint {
  font-size: 12px;
  color: #777;
}

/* ========== Main Area ========== */
.main {
  flex: 1;
  padding: 25px;
  overflow-y: auto;
}

.main-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 25px;
}

.main-title {
  font-size: 26px;
  font-weight: bold;
}

.main-subtitle {
  font-size: 14px;
  color: #999;
}

.main-controls {
  display: flex;
  align-items: center;
  gap: 10px;
}

.tag {
  background: #333;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 12px;
}

.tag.accent {
  background: #4caf50;
  color: #000;
}

.action-btn {
  background: #555;
  border: none;
  padding: 10px 16px;
  border-radius: 6px;
  cursor: pointer;
  color: #fff;
}

.action-btn.primary {
  background: #4caf50;
  color: #000;
}

/* ========== Panels ========== */
.panel {
  background: #111;
  border: 2px solid #222;
  border-radius: 10px;
  margin-bottom: 25px;
  padding: 20px;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15px;
}

.panel-title {
  font-size: 20px;
  font-weight: bold;
}

.panel-subtitle {
  font-size: 13px;
  color: #888;
}

.panel-tags {
  display: flex;
  gap: 10px;
}

/* ========== Lists ========== */
.list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.list-item {
  background: #222;
  padding: 12px;
  border-radius: 6px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-title {
  font-size: 16px;
  font-weight: bold;
}

.list-meta {
  font-size: 12px;
  color: #aaa;
}

.pill {
  background: #444;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 12px;
}

.pill.success {
  background: #4caf50;
  color: #000;
}

.pill.warning {
  background: #ff9800;
  color: #000;
}

.pill.danger {
  background: #f44336;
  color: #000;
}

/* ========== Steps Manager ========== */
.steps-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.steps-column-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 10px;
}

.steps-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.step-item {
  background: #222;
  padding: 12px;
  border-radius: 6px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.step-title {
  font-size: 15px;
  font-weight: bold;
}

.step-meta {
  font-size: 12px;
  color: #aaa;
}

/* ========== Logs ========== */
.logs-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.log-item {
  background: #222;
  padding: 12px;
  border-radius: 6px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.log-text {
  font-size: 13px;
}

.log-tag {
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 12px;
}

.log-tag.info {
  background: #4caf50;
  color: #000;
}

.log-tag.event {
  background: #2196f3;
  color: #000;
}

.log-tag.error {
  background: #f44336;
  color: #000;
}
